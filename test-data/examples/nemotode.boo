    // GABAergic motor neurons that relax the opposite muscles: DD, VD.
    (name=inhibitory_motor, members=[DD1, DD2, DD3, DD4, DD5, DD6, VD1, VD10, VD11, VD12, VD13, VD2, VD3, VD4, VD5, VD6, VD7, VD8, VD9]),
    // The pharyngeal nervous system (feeding), nearly separate from the rest.
