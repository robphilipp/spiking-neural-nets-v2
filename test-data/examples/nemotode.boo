    // Amphid and phasmid chemosensory neurons: smell, taste, pheromones.
    (name=chemosensory, members=[ADFL, ADFR, ADLL, ADLR, ASEL, ASER, ASGL, ASGR, ASHL, ASHR, ASIL, ASIR, ASJL, ASJR, ASKL, ASKR, AWAL, AWAR, AWBL, AWBR, AWCL, AWCR, PHAL, PHAR, PHBL, PHBR]),
    // Volatile odours: AWA (attractive), AWB (repulsive), AWC (attractive).
    (name=olfactory, members=[AWAL, AWAR, AWBL, AWBR, AWCL, AWCR]),
    // Water-soluble attractants such as salt: ASE.
    (name=salt, members=[ASEL, ASER]),
    // Temperature: AFD.
    (name=thermosensory, members=[AFDL, AFDR]),
    // Gentle touch to the front of the body: ALM, AVM.
    (name=touch_anterior, members=[ALML, ALMR, AVM]),
    // Gentle touch to the back of the body: PLM, PVM.
    (name=touch_posterior, members=[PLML, PLMR, PVM]),
    // Harsh touch and noxious stimuli: ASH, ADL, FLP, PVD.
    (name=nociceptive, members=[ADLL, ADLR, ASHL, ASHR, FLPL, FLPR, PVDL, PVDR]),
    // Touch to the nose: OLQ, IL1, CEP.
    (name=nose_touch, members=[CEPDL, CEPDR, CEPVL, CEPVR, IL1DL, IL1DR, IL1L, IL1R, IL1VL, IL1VR, OLQDL, OLQDR, OLQVL, OLQVR]),
    // Oxygen and carbon dioxide: URX, AQR, PQR (oxygen), BAG (CO2).
    (name=oxygen_co2, members=[AQR, BAGL, BAGR, PQR, URXL, URXR]),
    // Locomotion command interneurons: AVA, AVD, AVE (backward), AVB, PVC (forward).
    (name=command_interneurons, members=[AVAL, AVAR, AVBL, AVBR, AVDL, AVDR, AVEL, AVER, PVCL, PVCR]),
    // Excitatory motor neurons for forward crawling: VB, DB.
    (name=forward_motor, members=[DB1, DB2, DB3, DB4, DB5, DB6, DB7, VB1, VB10, VB11, VB2, VB3, VB4, VB5, VB6, VB7, VB8, VB9]),
    // Excitatory motor neurons for backward crawling: VA, DA.
