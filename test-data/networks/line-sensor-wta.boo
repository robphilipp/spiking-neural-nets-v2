    (name=output, threshold=6.5 mV, refractory_period=20 ms, relative_refractoriness=0.1 µWb, resting_potential=0 mV, decay_time=250 ms, rise_time=2 ms, membrane_noise=0.1 mV, spike_potential=1 mV, conduction_speed=1 m/s),
],
