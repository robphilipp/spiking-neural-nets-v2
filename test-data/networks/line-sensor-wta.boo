    (name=stdp, decay=(time=2 h), limits=(min=0, max=5), release=(facilitation_base=1, facilitation_step=0.1, facilitation_time=100 ms, depletion_base=10, depletion_step=1, depletion_time=100 ms), learning=stdp),
    (name=fixed, decay=(time=2 h), limits=(min=0, max=5), release=(facilitation_base=1, facilitation_step=0.1, facilitation_time=100 ms, depletion_base=10, depletion_step=1, depletion_time=100 ms)),
